{
  "opencollection": "1.0.0",
  "info": {
    "name": "Loyverse Categories Stores API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Stores",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List stores",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.loyverse.com/v1.0/stores",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque cursor for the next page of results."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return per page."
              }
            ]
          },
          "docs": "List stores"
        },
        {
          "info": {
            "name": "Get a store",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.loyverse.com/v1.0/stores/:store_id",
            "params": [
              {
                "name": "store_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a store"
        }
      ]
    }
  ],
  "bundled": true
}